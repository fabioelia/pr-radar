{
  "manifest_version": 3,
  "name": "PR Radar",
  "version": "0.8.0",
  "description": "Your open PRs, their checks, labels and linked Claude sessions in one side panel.",
  "key": "",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "sidePanel",
    "downloads",
    "idle",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*",
    "https://claude.ai/*",
    "https://*.blob.core.windows.net/*",
    "https://*.actions.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "PR Radar",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://github.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
